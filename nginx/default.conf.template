# Serves the static frontend and proxies /api to the Registry API, so the browser
# only ever talks to one origin (no CORS). ${PORT} and ${BACKEND_URL} are filled in at container start.
server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass ${BACKEND_URL};
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /health {
        access_log off;
        return 200 'ok';
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
